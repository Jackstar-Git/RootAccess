<button type="button" class="theme-switch" title="Toggle light/dark mode" aria-label="Toggle light and dark mode" aria-pressed="false">
    <div class="switch-track">
        <i class="fa-solid fa-sun" aria-hidden="true"></i>
        <i class="fa-solid fa-moon" aria-hidden="true"></i>
        <div class="switch-thumb"></div>
    </div>
</button>

<script>
(function () {
    const switches = document.querySelectorAll('.theme-switch');
    const root = document.documentElement;

    function applyMode(mode) {
        if (typeof window.setActiveTheme === 'function') {
            window.setActiveTheme(mode);
        } else {
            root.dataset.theme = mode;
            document.getElementById('active-custom-theme')?.remove();
            try {
                localStorage.setItem('active-theme', mode);
            } catch (e) {
                console.warn('Unable to persist theme preference:', e);
            }
        }

        const isDark = mode === 'dark';
        switches.forEach((switchEl) => {
            const thumb = switchEl.querySelector('.switch-thumb');
            switchEl.classList.toggle('dark', isDark);
            switchEl.setAttribute('aria-pressed', String(isDark));
            if (thumb) thumb.style.transform = isDark ? 'translateX(26px)' : 'translateX(0)';
        });
    }

    function toggleTheme() {
        const activeTheme = window.portfolioThemes?.find((theme) => theme.id === root.dataset.theme);
        const isDark = activeTheme?.color_schema === 'dark' || root.dataset.theme === 'dark';
        const current = isDark ? 'light' : 'dark';
        applyMode(current);
    }

    const activeTheme = window.portfolioThemes?.find((theme) => theme.id === root.dataset.theme);
    const initial = activeTheme?.color_schema === 'dark' || root.dataset.theme === 'dark';
    switches.forEach((switchEl) => {
        const thumb = switchEl.querySelector('.switch-thumb');
        switchEl.classList.toggle('dark', initial);
        switchEl.setAttribute('aria-pressed', String(initial));
        if (thumb) thumb.style.transform = initial ? 'translateX(26px)' : 'translateX(0)';
    });

    switches.forEach((switchEl) => switchEl.addEventListener('click', toggleTheme));
})();
</script>
