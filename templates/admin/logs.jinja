<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="{{ url_for('static', filename='assets/images/logos/LogoBrand.png') }}" type="image">
    <title>Admin Panel - Server Logs & Console</title>

    <link rel="preload" href="{{ url_for('static', filename='/assets/fonts/Montserrat/Montserrat-VariableFont_wght.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ url_for('static', filename='/assets/fonts/Montserrat/Montserrat-Italic-VariableFont_wght.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ url_for('static', filename='css/root.css') }}" as="style">

    <script src="{{ url_for('static', filename='js/global_preloader.js')}}"></script>
    
    <link rel="stylesheet" href="{{ url_for('static', filename='assets/fonts/font-awesome/reduced.all.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/root.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/admin/logs.css') }}">
</head>
<body>
    <div class="main-container">
        {% include "admin/sidebar.jinja" %}
        <div class="main-content">
            <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" title="Toggle Menu" aria-label="Toggle navigation menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <h2>Server Logs & Remote Console</h2>

            <div class="filter-bar">
                <input type="hidden" id="csrf_token" name="csrf_token" value="{{ generate_token() }}">
                
                <div class="filter-controls">
                    <select id="severityFilter" name="severityFilter">
                        <option value="ALL" selected>All Levels</option>
                        <option value="DEBUG">Debug</option>
                        <option value="INFO">Info</option>
                        <option value="WARNING">Warnings</option>
                        <option value="ERROR">Errors</option>
                        <option value="CRITICAL">Critical</option>
                    </select>

                    <select id="itemsFilter" name="itemsFilter">
                        <option value="50">Last 50</option>
                        <option value="100">Last 100</option>
                        <option value="500" selected>Last 500</option>
                        <option value="1000">Last 1000</option>
                        <option value="10000">Last 10000</option>
                        <option value="0">All</option>
                    </select>

                    <select id="sortingFilter" name="sortingFilter">
                        <option value="ASC">Oldest first</option>
                        <option value="DESC" selected>Newest first</option>
                    </select>
                </div>

                <button class="btn-primary" id="applyFilters" onclick="fetchLogs()">
                    <i class="fa-solid fa-filter"></i> Apply filters
                </button>
                <a class="btn-primary" id="exportLogsBtn" href="{{ url_for('admin.export_server_logs') }}">
                    <i class="fa-solid fa-download"></i> Export logs
                </a>
                <button class="btn-danger" id="clearLogsBtn" onclick="clearLogs()">
                    <i class="fa-solid fa-broom"></i> Clear logs
                </button>
            </div>

            <div class="logs-container">
                <div id="logsOutput">
                    <span class="log-empty">Loading logs...</span>
                </div>
                
                <div class="console-bar">
                    <input type="password" id="consolePassword" placeholder="Console PWD" autocomplete="off">
                    <input type="text" id="consoleInput" placeholder="Enter a command (e.g. 'help')..." autocomplete="off">
                    <button class="btn-console" onclick="sendCommand()">Send</button>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ url_for('static', filename='js/admin/logs.js')}}"></script>
</body>
</html>