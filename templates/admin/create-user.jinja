<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="{{ url_for('static', filename='assets/images/logos/LogoBrand.png') }}" type="image/png">
    <title>Admin - Create User</title>

    <link rel="preload" href="{{ url_for('static', filename='/assets/fonts/Montserrat/Montserrat-VariableFont_wght.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ url_for('static', filename='/assets/fonts/Montserrat/Montserrat-Italic-VariableFont_wght.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ url_for('static', filename='css/root.css') }}" as="style">

    <script src="{{ url_for('static', filename='js/global_preloader.js') }}"></script>

    <link rel="stylesheet" href="{{ url_for('static', filename='assets/fonts/font-awesome/reduced.all.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/root.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/admin/edit-user.css') }}">
</head>
<body>
    <div class="main-container">
        {% include "admin/sidebar.jinja" %}

        <main class="main-content">
            <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" title="Toggle Menu" aria-label="Toggle navigation menu">
                <i class="fa-solid fa-bars"></i>
            </button>

            <header class="editor-header">
                <h2>Create User</h2>
                <div class="header-actions">
                    <a href="/admin/users/all" class="btn-discard">Discard</a>
                </div>
            </header>

            <form method="POST" action="{{ url_for('admin.create_user') }}" enctype="multipart/form-data" class="modern-form" id="user-form">
                <input type="hidden" name="csrf_token" id="csrf_token" value="{{ generate_token() }}">

                <div class="editor-layout">
                    <section class="content-area">
                        <div class="settings-group">
                            <label>Username</label>
                            <input type="text" name="username" class="modern-input" placeholder="john.doe" required>
                        </div>

                        <div class="settings-group">
                            <label>Password</label>
                            <input type="password" name="password" class="modern-input" placeholder="At least 6 characters" required>
                        </div>

                        <div class="settings-group">
                            <label>Account Status</label>
                            <select name="status" class="modern-select">
                                <option value="active">Active</option>
                                <option value="banned">Banned (Login not possible)</option>
                                <option value="disabled">Disabled (Will be neutralized)</option>
                                <option value="test">Test Account</option>
                            </select>
                        </div>

                        <div class="settings-group">
                            <label>Admin-Note (e.g. Ban-Reason)</label>
                            <textarea name="notes" class="modern-textarea" rows="4" placeholder="Internal user note..."></textarea>
                        </div>

                        <div class="settings-group">
                            <label>Profile Picture</label>
                            <div class="upload-container" id="drop-zone">
                                <input type="file" id="profile-pic-upload" name="profile_picture" accept="image/*" hidden>
                                <div id="profile-pic-preview" class="preview-box">
                                    <i class="fas fa-user-circle fa-3x" style="color: var(--main-color-400); margin-bottom: 10px;"></i>
                                    <p>Click to upload profile picture</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <aside class="settings-sidebar">
                        <div class="settings-group">
                            <label>Hierarchy Level</label>
                            <select name="hierarchy_level" class="modern-select" style="min-height: auto;">
                                {% for level in range(0, 11) %}
                                    {% if level <= 5 or level == 10 %}
                                    <option value="{{ level }}" {% if level == 3 %}selected{% endif %} {% if not has_permission(user_permissions, Permission.SYSTEM_ROOT) and current_user.hierarchy_level and current_user.hierarchy_level >= level %}disabled{% endif %}>
                                        {% if level == 0 %}
                                            👑 Root (Level 0)
                                        {% elif level == 1 %}
                                            🛡️ Admin (Level 1)
                                        {% elif level == 2 %}
                                            ✏️ Editor (Level 2)
                                        {% elif level == 3 %}
                                            🏷️ Guest (Level 3)
                                        {% elif level == 10 %}
                                            👻 Deleted (Level 10)
                                        {% else %}
                                            👤 User (Level {{ level }})
                                        {% endif %}
                                    </option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                            {% if not has_permission(user_permissions, Permission.SYSTEM_ROOT) %}
                                <p class="help-text">You can only create users below your own hierarchy level.</p>
                            {% endif %}
                        </div>

                        <div class="settings-group">
                            <label>Permissions</label>
                            <div class="permissions-grid">
                                {% for perm_name, perm_value in permissions_list %}
                                    {% if has_permission(user_permissions, Permission.SYSTEM_ROOT) or has_permission(user_permissions, perm_value) %}
                                        <label class="permission-checkbox">
                                            <input type="checkbox" name="perm_{{ perm_value }}" value="{{ perm_value }}">
                                            <span>{{ perm_name }}</span>
                                        </label>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            {% if not has_permission(user_permissions, Permission.SYSTEM_ROOT) %}
                                <p class="help-text">You can only grant permissions you have.</p>
                            {% endif %}
                        </div>

                        <button type="submit" class="btn-primary btn-publish">Create User</button>
                    </aside>
                </div>
            </form>
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const uploadInput = document.getElementById("profile-pic-upload");
            const dropZone = document.getElementById("drop-zone");
            const previewBox = document.getElementById("profile-pic-preview");

            if (uploadInput && dropZone) {
                dropZone.addEventListener("click", () => uploadInput.click());
                uploadInput.addEventListener("change", (e) => {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = (ev) => {
                            previewBox.innerHTML = `<img src="${ev.target.result}" class="preview-image">`;
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>

    <script src="{{ url_for('static', filename='js/admin/admin-global.js') }}"></script>
</body>
</html>
